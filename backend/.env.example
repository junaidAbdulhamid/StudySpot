APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://studyspot:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/studyspot
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
# Only used by app.seed.run; unrelated to signed-in requests.
DEV_USER_ENABLED=true
DEV_USER_ID=dev-studyspot
# From your Supabase project settings. Leave blank to run the catalog endpoints
# without sign-in; /me and its sub-routes then answer 503 AUTH_UNAVAILABLE.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Tests require a separate database name ending in _test and APP_ENV=test.
TEST_DATABASE_URL=postgresql+psycopg://studyspot:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/studyspot_test
