# Include the API version prefix. Restart Expo after changing this value.
# iOS simulator / browser:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8001/api/v1
# Android emulator: http://10.0.2.2:8001/api/v1
# Physical device: http://YOUR_COMPUTER_LAN_IP:8001/api/v1

# From your Supabase project's Settings > API page. Leave both blank to preview
# the app without sign-in: onboarding and the login screen still render, but
# every sign-in button fails with "Sign-in needs Supabase configuration."
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional MapLibre-compatible style URL. The default uses OpenFreeMap dark tiles.
EXPO_PUBLIC_MAP_STYLE_URL=
# Optional HTTPS endpoint of an OSRM service configured with a walking profile.
# Example: https://YOUR_ROUTER/route/v1/foot (no public demo server in production).
EXPO_PUBLIC_WALKING_ROUTE_URL=
# Enable Google sign-in for this exact URL under Authentication >
# URL Configuration > Redirect URLs in the Supabase dashboard:
# studyspot://auth/callback
